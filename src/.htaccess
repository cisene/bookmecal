# Root .htaccess - Book Me Calendar
# Never print errors to visitors (leaks paths/config); they still go to the error log
php_flag display_startup_errors off
php_flag display_errors off
php_flag log_errors on
php_value error_reporting 2047

ServerSignature Off
FileEtag MTime

# Disable MultiViews and follow symlinks
Options -MultiViews +FollowSymLinks

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# 1. Protect internal folders: data, cache, logs, PHP classes and templates
RewriteRule ^(.*/)?(cache|data|log|classes|templates)/.*$ - [F,L]
RewriteRule ^bootstrap\.php$ - [F,L]

# 2. Block unnecessary or risky HTTP methods
RewriteCond %{REQUEST_METHOD} ^(CONNECT|DEBUG|DELETE|MOVE|PUT|TRACE|TRACK) [NC]
RewriteRule .* - [F,L]

# 3. Security headers for static files (PHP pages and the API send their own via SecurityHeaders)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|json|png|jpe?g|gif|svg|ico|webp|woff2?)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Referrer-Policy "same-origin"
        Header set Cross-Origin-Resource-Policy "same-origin"
    </FilesMatch>
</IfModule>

# No CORS here: api.php answers cross-origin requests itself, only for origins listed
# in data/settings.json (allowed_origins)

# ==========================================
# PROJECT REWRITE RULES
# ==========================================

# API Route -> api.php
RewriteRule ^api/?$ api.php [L,QSA]

# Calendar Feed Well-known standard route
RewriteRule ^\.well-known/calendar/?$ api.php?action=feed [L,QSA]

# Home page -> index.php
RewriteRule ^$ index.php [L]

# Fallback route for unmapped paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]