# Root .htaccess - Book Me Calendar
php_flag display_startup_errors on
php_flag display_errors on
php_flag log_errors on
php_value error_reporting 2047

ServerSignature Off
FileEtag MTime

# Disable MultiViews and follow symlinks
Options -MultiViews +FollowSymLinks

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# 1. Protect sensitive folders (cache/ and data/) using RewriteRule instead of RedirectMatch
RewriteRule ^(.*/)?(cache|data)/.*$ - [F,L]

# 2. Block unnecessary or risky HTTP methods
RewriteCond %{REQUEST_METHOD} ^(CONNECT|DEBUG|DELETE|MOVE|PUT|TRACE|TRACK) [NC]
RewriteRule .* - [F,L]

# 3. CORS headers for API requests
<IfModule mod_headers.h>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Handle preflight OPTIONS requests directly
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=204,L]

# ==========================================
# PROJECT REWRITE RULES
# ==========================================

# API Route -> api.php
RewriteRule ^api/?$ api.php [L,QSA]

# Calendar Feed Well-known standard route
RewriteRule ^\.well-known/calendar/?$ api.php?action=feed [L,QSA]

# Home page -> index.php
RewriteRule ^$ index.php [L]

# Fallback route for unmapped paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]