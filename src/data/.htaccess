# .htaccess - Protect data directory by redirecting access attempts to the parent directory

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ ../ [R=302,L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Fallback for servers without mod_rewrite: deny access completely
    Require all denied
</IfModule>