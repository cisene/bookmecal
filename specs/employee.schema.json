{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Employee",
  "description": "Schema representing an employee or practitioner profile in the booking system, including professional qualifications, certificates, diplomas, and business attributes.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier or employee code."
    },
    "givenName": {
      "type": "string",
      "description": "First or given name of the employee."
    },
    "familyName": {
      "type": "string",
      "description": "Last or family name of the employee."
    },
    "additionalName": {
      "type": "string",
      "description": "Middle name. vCard N (additional names)."
    },
    "honorificPrefix": {
      "type": "string",
      "description": "Title before the name, e.g. Leg. or Dr. vCard N (prefix)."
    },
    "honorificSuffix": {
      "type": "string",
      "description": "Title after the name, e.g. MSc. vCard N (suffix)."
    },
    "nickname": {
      "type": "string",
      "description": "vCard NICKNAME."
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "description": "URL of the employee's photo (http/https). vCard PHOTO when businessAttributes.showPhoto is true."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Professional email address. vCard EMAIL."
    },
    "phoneNumber": {
      "type": "string",
      "description": "Primary or office phone number. vCard TEL (WORK)."
    },
    "mobileNumber": {
      "type": "string",
      "description": "Direct mobile phone number. vCard TEL (CELL)."
    },
    "swishPaymentNumber": {
      "type": "string",
      "description": "07xxx number or 123xxx xx xx number"
    },
    "inactive": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating whether the employee is currently inactive or deactivated."
    },
    "isBookable": {
      "type": "boolean",
      "default": true,
      "description": "Employee is bookable"
    },
    "jobTitle": {
      "type": "string",
      "description": "Professional title or role (e.g., Licensed Medical Foot Care Specialist). vCard TITLE."
    },
    "role": {
      "type": "string",
      "description": "Role or function, e.g. Manager. vCard ROLE."
    },
    "website": {
      "type": "string",
      "format": "uri",
      "description": "Personal or professional web page (http/https). vCard URL."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages the employee speaks. In the vCard NOTE (vCard 3.0 has no LANG)."
    },
    "socialProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Social media profile URLs. vCard X-SOCIALPROFILE with the network as TYPE when known."
    },
    "bio": {
      "type": "string",
      "description": "Short presentation for customers. vCard NOTE."
    },
    "shareContact": {
      "type": "boolean",
      "default": false,
      "description": "The employee agreed that customers get their contact card (settings.json vcard 'staff')."
    },
    "organisationNumber": {
      "type": "string",
      "description": "Corporate or organizational registration number (e.g., Swedish Org.nr)."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Treatments (keys in data/services.json) this employee offers. Empty or missing = all treatments."
    },
    "schedule": {
      "type": [
        "object",
        "null"
      ],
      "description": "Weekly working hours: weekday => whole hours worked (\"08:00\" = 08:00-09:00). Cut to the opening hours when bookings are calculated. Missing or null = the employee follows the opening hours.",
      "propertyNames": {
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):00$"
        }
      }
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of professional qualifications or licenses held. vCard CATEGORIES."
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issueDate": {
            "type": "string",
            "format": "date"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "Certificates and professional accreditations."
    },
    "diplomas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "Academic degrees and professional diplomas."
    },
    "businessAttributes": {
      "type": "object",
      "description": "Assortment of operational attributes.",
      "properties": {
        "bookCancel": {
          "type": "integer",
          "default": 1440,
          "description": "Minimum time before cancellation of booking in minutes."
        },
        "bookInAdvance": {
          "type": "integer",
          "default": 15,
          "description": "Booking days ahead"
        },
        "acceptsValueCard": {
          "type": "boolean",
          "default": false,
          "description": "Accepts value card"
        },
        "allowCustomerMessage": {
          "type": "boolean",
          "default": false,
          "description": "Allow customer message in booking"
        },
        "blockCancelBooking": {
          "type": "boolean",
          "default": false,
          "description": "Block cancellation of booking"
        },
        "sellsGiftCard": {
          "type": "boolean",
          "default": false,
          "description": "Selling Giftcard"
        },
        "sellsValueCard": {
          "type": "boolean",
          "default": false,
          "description": "Selling ValueCard"
        },
        "showPhoto": {
          "type": "boolean",
          "default": false,
          "description": "Show photo of employee in presentation"
        },
        "useCashPayment": {
          "type": "boolean",
          "default": false,
          "description": "Cash payments are allowed"
        },
        "useCashPartialPayment": {
          "type": "boolean",
          "default": false,
          "description": "Cash partial payments are allowed"
        },
        "useInvoicePayment": {
          "type": "boolean",
          "default": false,
          "description": "Invoicing are allowed"
        },
        "useSwishPayment": {
          "type": "boolean",
          "default": false,
          "description": "Swish payments are allowed"
        },
        "visibleTimes": {
          "type": "boolean",
          "default": false,
          "description": "Allow available times to be visible"
        },
        "department": {
          "type": "string",
          "description": "Department within the business. vCard ORG (second part)."
        },
        "location": {
          "type": "string"
        },
        "specialties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDays": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "customNotes": {
          "type": "string"
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last record modification."
    },
    "updatedBy": {
      "type": "string",
      "description": "User or administrator who last modified the profile."
    }
  },
  "required": [
    "givenName",
    "familyName",
    "organisationNumber"
  ]
}
