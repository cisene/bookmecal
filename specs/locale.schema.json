{
  "$schema": "[https://json-schema.org/draft/2020-12/schema](https://json-schema.org/draft/2020-12/schema)",
  "title": "LocaleConfiguration",
  "type": "object",
  "required": [
    "locale",
    "language",
    "currency",
    "formats",
    "calendar"
  ],
  "properties": {
    "locale": {
      "type": "string",
      "description": "Locale identifier (e.g., sv_SE)."
    },
    "language": {
      "type": "string",
      "description": "Language name (e.g., Swedish)."
    },
    "currency": {
      "type": "object",
      "required": [
        "code",
        "symbol",
        "position"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code (e.g., SEK)."
        },
        "symbol": {
          "type": "string",
          "description": "Currency symbol (e.g., kr)."
        },
        "position": {
          "type": "string",
          "enum": [
            "prefix",
            "suffix"
          ],
          "description": "Placement of the currency symbol relative to the amount."
        }
      }
    },
    "formats": {
      "type": "object",
      "required": [
        "date",
        "time"
      ],
      "properties": {
        "date": {
          "type": "string",
          "description": "Date formatting pattern (e.g., YYYY-MM-DD)."
        },
        "time": {
          "type": "string",
          "description": "Time formatting pattern (e.g., HH:mm)."
        }
      }
    },
    "calendar": {
      "type": "object",
      "required": [
        "startOfWeek"
      ],
      "properties": {
        "startOfWeek": {
          "type": "string",
          "enum": [
            "monday",
            "sunday",
            "saturday"
          ],
          "description": "The first day of the week for UI calendar rendering."
        }
      }
    }
  }
}