{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlotMatrix",
  "type": "object",
  "properties": {
    "day_of_week": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "start_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d):([0-5]\\d)$"
    },
    "end_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d):([0-5]\\d)$"
    },
    "is_active": {
      "type": "integer",
      "enum": [0, 1]
    }
  },
  "required": ["day_of_week", "start_time", "end_time"]
}