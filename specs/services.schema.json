{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "duration": {
      "type": "integer",
      "minimum": 5
    },
    "cleanup": {
      "type": "integer",
      "minimum": 0,
      "description": "Buffer or cleanup time in minutes following the service."
    },
    "price": {
      "type": "number",
      "minimum": 0.00
    }
  },
  "required": [
    "name",
    "duration",
    "price"
  ]
}